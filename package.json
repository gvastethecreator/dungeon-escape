{
  "name": "dungeon-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:check": "bun install --frozen-lockfile",
    "dev": "vite --host 127.0.0.1 --port 24211 --strictPort",
    "build": "bun run typecheck:all && vite build",
    "build:code": "bun run typecheck:all && vite build --mode code-verification",
    "profile:resident-load:g0": "bun run scripts/capture-dungeon-load-g0.ts",
    "parity:compare": "bun test tests/visual-parity-compare.test.ts tests/visual-parity-capture.test.ts",
    "parity:capture": "bun run scripts/capture-visual-parity-matrix.ts",
    "perf:baseline:compare": "bun test tests/perf-baseline-compare.test.ts tests/perf-baseline-capture.test.ts",
    "perf:baseline:capture": "bun run scripts/capture-perf-baseline.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "typecheck:all": "bun run typecheck && bun run typecheck:server && bun run typecheck:worker",
    "lint": "oxlint .",
    "fmt": "oxfmt . '!docs/codemap/**' '!assets-source/runtime-optimization-manifest.json'",
    "fmt:check": "oxfmt --check . '!docs/codemap/**' '!assets-source/runtime-optimization-manifest.json'",
    "check": "bun run typecheck:all && bun run lint && bun run fmt:check && bun run test && bun run audit:runtime-assets && bun run build:code",
    "clean": "bun run scripts/clean.mjs",
    "deps:outdated": "bun outdated",
    "deps:audit": "bun audit",
    "smoke:multi-floor": "bun run scripts/multi-floor-browser-smoke.mjs",
    "smoke:mobile": "bun run scripts/mobile-ui-smoke.mjs",
    "optimize:runtime-assets": "python scripts/optimize-runtime-assets.py",
    "audit:runtime-assets": "bun run scripts/audit-runtime-assets.ts",
    "audit:enemy-atlases": "python scripts/audit-enemy-atlases-v8.py --write-package-metadata",
    "generate:biome-textures": "bun run scripts/generate-biome-textures.ts",
    "generate:biome-palettes": "python scripts/extract-biome-surface-palettes.py",
    "bake:biome-pbr": ".venv-pbr\\Scripts\\python.exe scripts/bake-biome-pbr.py",
    "db:migrate:local": "wrangler d1 migrations apply LEADERBOARD_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply dungeon-escape-leaderboard --remote",
    "cloudflare:dev": "wrangler dev",
    "cloudflare:deploy": "bun run audit:runtime-assets && bun run build && wrangler deploy",
    "perf:baseline:hitl": "bun run scripts/evaluate-webgpu-hitl.ts",
    "webgpu:flip": "bun run scripts/flip-webgpu-default.ts",
    "webgpu:glsl-contraction": "bun run scripts/remove-legacy-glsl.ts"
  },
  "dependencies": {
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260809.1",
    "@types/bun": "^1.3.14",
    "@types/three": "^0.185.4",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "wrangler": "^4.120.0"
  },
  "packageManager": "bun@1.3.14"
}
