{
  "name": "dungeon-escape",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 24211 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "test": "bun test tests",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint .",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "generate:biome-textures": "bun run scripts/generate-biome-textures.ts",
    "bake:biome-pbr": ".venv-pbr\\Scripts\\python.exe scripts/bake-biome-pbr.py"
  },
  "dependencies": {
    "three": "^0.178.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/three": "^0.178.0",
    "oxfmt": "latest",
